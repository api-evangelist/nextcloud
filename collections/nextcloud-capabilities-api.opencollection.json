            "headers": [
              {
                "name": "OCS-APIRequest",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "format",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Obtain server and app capabilities"
        }
      ]
    }
  ],
  "bundled": true
}