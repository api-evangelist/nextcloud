{
  "opencollection": "1.0.0",
  "info": {
    "name": "Nextcloud OCS Autocomplete Capabilities API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
